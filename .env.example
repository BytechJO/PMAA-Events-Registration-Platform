# Copy to .env and fill in. Names only here: real values live in the secret manager (spec Appendix A).
# The app refuses to start when a required variable is missing (packages/core/src/env.ts).

NODE_ENV=development
APP_BASE_URL=http://localhost:3000

# PostgreSQL (docker compose up -d db)
DATABASE_URL=postgres://pmaa:pmaa@localhost:5432/pmaa
TEST_DATABASE_URL=postgres://pmaa:pmaa@localhost:5432/pmaa_test

# Admin sign-in: Microsoft Entra ID (T011). Leave empty until PMAA provides them (EXT-C2, EXT-C5).
AUTH_SECRET=
AUTH_MICROSOFT_ENTRA_ID_ID=
AUTH_MICROSOFT_ENTRA_ID_SECRET=
AUTH_MICROSOFT_ENTRA_ID_ISSUER=

# Admin test sign-in on your own machine: pick a role without a Microsoft account (T012).
# Works only when APP_BASE_URL is localhost; anywhere else the app refuses to start.
ADMIN_DEV_SIGN_IN=

# Sample registrations for the public "You're registered" page until the registration API lands (T023, T022).
# Same rule: localhost only. Try /webinars/creating-engaging-digital-content/registered?token=sample-confirmed
PUBLIC_SAMPLE_DATA=

# Microsoft Graph: Teams and email (T031, T041). Leave empty until PMAA's admin consents (EXT-C2, EXT-C4).
GRAPH_TENANT_ID=
GRAPH_CLIENT_ID=
GRAPH_CLIENT_SECRET=
GRAPH_SENDER_MAILBOX=
GRAPH_ORGANIZER_USER_ID=

# WhatsApp Cloud API (T051). Leave empty until onboarding is done (EXT-C6).
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_APP_SECRET=

# Bot protection (T024)
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
